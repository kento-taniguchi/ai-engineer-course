# 本番連携用の設定の見本（試作版では使いません）
# このファイルをコピーして .env.local という名前にし、値を入れてください。
# .env.local はGitに登録されません。鍵をソースコードや README に書かないでください。

# 保存先の切り替え（local = このブラウザ / sheets = Googleスプレッドシート）
NEXT_PUBLIC_DATA_BACKEND=local

# Googleスプレッドシート・ドライブ（サーバー側でのみ使用）
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
